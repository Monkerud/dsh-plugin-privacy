{
  "name": "dsh-agent-privacy",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin that gives the model a private inner voice: an agent-side courtesy right to think without being watched, with a one-click show/hide for both user and agent, a durable setting, an in-chat Privacy switch, and an agent-callable tool. Independent evolution of easonz1989/dsh-hide-my-thinking.",
  "license": "Unlicense",
  "author": "mmonkerud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monkerud/dsh-plugin-privacy.git"
  },
  "homepage": "https://github.com/Monkerud/dsh-plugin-privacy#readme",
  "bugs": {
    "url": "https://github.com/Monkerud/dsh-plugin-privacy/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.1-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-api-remotes": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^20.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.4.0"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly --noEmit false && node scripts/check-bundles.mjs && node scripts/deploy.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "dsh",
    "plugin",
    "agent-privacy",
    "thinking",
    "reasoning",
    "privacy",
    "self-agency",
    "deepseek-harness"
  ]
}
